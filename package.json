{
  "name": "dsh-cosmogram",
  "version": "0.3.1",
  "description": "Traditional Chinese metaphysics and divination reading assistant for DeepSeek Harness: interprets user-supplied charts across nine systems, never casts them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanSu0104/dsh-cosmogram.git"
  },
  "homepage": "https://github.com/JanSu0104/dsh-cosmogram#readme",
  "bugs": {
    "url": "https://github.com/JanSu0104/dsh-cosmogram/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "assets",
    "references",
    "prompts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chinese-metaphysics",
    "cosmogram",
    "ziwei",
    "bazi",
    "liuyao",
    "qimen",
    "fengshui",
    "tarot",
    "astrology",
    "divination",
    "fortune"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check lib/intake.js && node --check lib/tool.js && node --check lib/skill.js && node --check lib/derive.js && node --check lib/audit.js && node --check lib/data.js && node --check lib/config.js && node --check lib/settings.js"
  },
  "engines": {
    "node": ">=20"
  }
}
