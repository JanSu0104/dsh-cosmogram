{
  "name": "dsh-suanming",
  "version": "0.1.0",
  "description": "Traditional Chinese metaphysics and divination reading assistant for DeepSeek Harness: interprets user-supplied charts across nine systems, never casts them.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "assets",
    "references",
    "prompts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chinese-metaphysics",
    "ziwei",
    "bazi",
    "liuyao",
    "qimen",
    "fengshui",
    "tarot",
    "astrology",
    "divination",
    "fortune"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check lib/intake.js && node --check lib/tool.js && node --check lib/skill.js"
  },
  "engines": {
    "node": ">=20"
  }
}
