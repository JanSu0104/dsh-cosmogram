        { "key": "hexagram", "label": "本卦与变卦" },
        { "key": "moving", "label": "动爻" },
        { "key": "monthDay", "label": "月建与日辰" }
      ],
      "optional": ["世应", "六亲", "六神", "用神取法"]
    },
    {
