{
  "name": "cosmogram",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Machine-readable intake contract for the nine supported systems. It lists minimum evidence only; it never defines chart calculation.",
  "outputStructure": [
    "当前使用的体系与数据来源",
    "关键信息摘要",
    "核心判断",
    "主要依据",
    "不确定或需要补充的信息",
    "可执行建议",
    "可继续追问的问题"
  ],
  "systems": [
    {
      "id": "ziwei",
      "label": "紫微斗数",
      "en": "Zi Wei Dou Shu",
      "required": [
        { "key": "palaces", "label": "宫位与命宫落点" },
        { "key": "stars", "label": "主星/辅星" },
        { "key": "sihua", "label": "生年四化" }
      ],
      "optional": ["大限与流年", "出生时间与性别", "身宫落点"]
    },
    {
      "id": "bazi",
      "label": "八字四柱",
