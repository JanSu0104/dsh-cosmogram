      "label": "奇门遁甲",
      "en": "Qi Men Dun Jia",
      "required": [
        { "key": "ju", "label": "阴阳遁与局数" },
        { "key": "palaces", "label": "九宫盘面" },
        { "key": "gates", "label": "八门/九星/八神" }
